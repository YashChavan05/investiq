GROQ_API_KEY=your_groq_api_key_here
# Run: python -c "from groq import Groq; [print(m.id) for m in Groq(api_key='YOUR_KEY').models.list().data]"
# to see models available on your key, then set one below
GROQ_MODEL=qwen/qwen3.8-27b
NEWS_API_KEY=your_newsapi_key_here
MONGO_URL=mongodb://localhost:27017
DB_NAME=investiq_db

# Production: set to your Vercel deployment URL
FRONTEND_URL=https://your-app.vercel.app

# LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT="InvestIQ-Dev"
